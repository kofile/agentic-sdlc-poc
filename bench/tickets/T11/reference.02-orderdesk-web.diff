@@ -20,6 +21,52 @@ export function NewOrderForm({ onCreated }: NewOrderFormProps) {
   const [lines, setLines] = useState<LineItemDraft[]>([emptyLine()]);
   const [error, setError] = useState<string | null>(null);
   const [submitting, setSubmitting] = useState(false);
+  const [preview, setPreview] = useState<DiscountPreview | null>(null);
+
+  // Live discount preview: resolves each line item's product to compute the
+  // order's subtotal client-side, then calls the preview endpoint. Skips
+  // silently (no preview, no error) whenever the code is empty or any line
+  // item doesn't yet resolve to a real product — the user just hasn't
+  // finished entering valid line items.
+  useEffect(() => {
+    const trimmedCode = discountCode.trim();
+    if (!trimmedCode) {
+      setPreview(null);
+      return;
+    }
+
+    const parsedLines = lines.map((line) => ({
+      productId: Number(line.product_id),
+      quantity: Number(line.quantity),
+    }));
+    const allValid = parsedLines.every(
+      (line) => Number.isInteger(line.productId) && line.productId > 0 && Number.isInteger(line.quantity) && line.quantity > 0,
+    );
+    if (!allValid) {
+      setPreview(null);
+      return;
+    }
+
+    let cancelled = false;
+    (async () => {
+      try {
+        const products = await Promise.all(parsedLines.map((line) => api.products.get(line.productId)));
+        if (cancelled) return;
+        const subtotalCents = products.reduce(
+          (sum, product, i) => sum + product.price_cents * parsedLines[i].quantity,
+          0,
+        );
+        const result = await api.discounts.preview(trimmedCode, subtotalCents);
+        if (!cancelled) setPreview(result);
+      } catch {
+        if (!cancelled) setPreview(null);
+      }
+    })();
+
+    return () => {
+      cancelled = true;
+    };
+  }, [discountCode, lines]);
 
   function updateLine(index: number, patch: Partial<LineItemDraft>) {
     setLines((prev) => prev.map((line, i) => (i === index ? { ...line, ...patch } : line)));
