+  /**
+   * A non-throwing preview of whether a discount code would apply to a
+   * hypothetical order with the given subtotal. Never creates an order or
+   * reserves stock. Returns `valid: false` (with a `reason`, never a thrown
+   * error) for an unknown, inactive, expired, or below-minimum code, so
+   * callers can show this directly without a try/catch.
+   */
+  preview(code: string, subtotalCents: number): { valid: boolean; discount_cents: number; reason: string | null } {
+    let discount: Discount;
+    try {
+      discount = this.getByCode(code);
+    } catch {
+      return { valid: false, discount_cents: 0, reason: "unknown discount code" };
+    }
+
+    if (!discount.active) {
+      return { valid: false, discount_cents: 0, reason: `discount ${discount.code} is not active` };
+    }
+    if (discount.expires_at && new Date(discount.expires_at).getTime() < Date.now()) {
+      return { valid: false, discount_cents: 0, reason: `discount ${discount.code} has expired` };
+    }
+    if (subtotalCents < discount.min_subtotal_cents) {
+      return {
+        valid: false,
+        discount_cents: 0,
+        reason: `order subtotal ${subtotalCents} is below the minimum ${discount.min_subtotal_cents} required for discount ${discount.code}`,
+      };
+    }
+
+    const discountCents =
+      discount.kind === "percent"
+        ? Math.floor((subtotalCents * discount.value) / 100)
+        : Math.min(discount.value, subtotalCents);
+
+    return { valid: true, discount_cents: discountCents, reason: null };
+  }
