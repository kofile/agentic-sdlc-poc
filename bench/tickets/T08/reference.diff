+
+  /**
+   * Summarizes a customer's business: order_count and total_spent_cents
+   * count only `paid` and `fulfilled` orders. `pending` orders haven't been
+   * paid yet and `cancelled` orders released their stock, so neither counts
+   * as business done.
+   */
+  summary(id: number): { customer_id: number; order_count: number; total_spent_cents: number } {
+    this.getById(id);
+    const row = this.db
+      .prepare(
+        `SELECT COUNT(*) as order_count, COALESCE(SUM(total_cents), 0) as total_spent_cents
+         FROM orders
+         WHERE customer_id = ? AND status IN ('paid', 'fulfilled')`,
+      )
+      .get(id) as { order_count: number; total_spent_cents: number };
+
+    return { customer_id: id, order_count: row.order_count, total_spent_cents: row.total_spent_cents };
+  }
 }
