{
  "name": "bench-harness",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Benchmark harness: bench CLI, SQLite store and uniform stage-run record (notes/02-benchmark-spec.md section 7).",
  "bin": {
    "bench": "src/cli.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "bench": "node --import tsx src/cli.ts",
    "test:g": "BENCH_G_E2E=1 vitest run tests/g.e2e.test.ts"
  },
  "dependencies": {
    "@temporalio/client": "1.25.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vitest": "2.1.9"
  }
}
